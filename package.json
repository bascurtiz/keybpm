{
  "name": "keybpm",
  "version": "1.0.0",
  "description": "The open music Key & BPM database — a fast, DJ-friendly music metadata explorer.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node scripts/test-queue-merge.mjs && node scripts/test-consensus-sources.mjs && node scripts/test-source-keys.mjs && node scripts/test-activity-order.mjs && node scripts/test-bpm-detector.mjs && node scripts/test-grid.mjs && node scripts/test-beat-tracker.mjs && node scripts/test-onset-latency.mjs && node scripts/test-mix-render.mjs && npm run bench:beats",
    "bench:beats": "node scripts/bench-beats.mjs",
    "bench:beats:corpus": "node scripts/bench-beats.mjs --corpus bench/corpus --no-gate --json bench/last-run.json",
    "typecheck": "tsc --noEmit",
    "data:import": "node scripts/import_duuzu.mjs && node scripts/export_csv.mjs",
    "data:consensus": "node scripts/import_consensus.mjs",
    "data:consensus:verify": "node scripts/rebuild_consensus_sources.mjs",
    "data:consensus:repair": "node scripts/rebuild_consensus_sources.mjs --apply && node scripts/export_csv.mjs",
    "data:source-keys": "node scripts/import_source_keys.mjs",
    "data:seed": "node scripts/seed_data.mjs",
    "data:csv": "node scripts/export_csv.mjs",
    "data:soundiiz": "node scripts/export_soundiiz.mjs",
    "data:tunemymusic": "node scripts/export_tunemymusic.mjs",
    "data:tunemymusic:gathered": "node scripts/import_soundiiz.mjs --gathered --dir=data/export-tunemymusic/to-import && node scripts/export_csv.mjs",
    "data:soundcloud:gathered": "node scripts/import_soundiiz.mjs --gathered --link=soundcloud --dir=data/export-tunemymusic/to-import --input=data/export-tunemymusic/missing-soundcloud.txt --report=data/export-tunemymusic/soundcloud-matches.tsv && node scripts/export_csv.mjs",
    "data:youtube": "node scripts/import_soundiiz.mjs && node scripts/export_csv.mjs",
    "data:youtube:reset": "node scripts/import_soundiiz.mjs --reset && node scripts/export_csv.mjs",
    "data:youtube:gathered": "node scripts/import_soundiiz.mjs --gathered --dir=data/export-soundiiz && node scripts/export_csv.mjs",
    "data:apply-queue": "node scripts/apply_submissions.mjs",
    "api:dev": "npm run dev --prefix workers/api",
    "api:deploy": "npm run deploy --prefix workers/api"
  },
  "keywords": [
    "music",
    "bpm",
    "key",
    "camelot",
    "dj",
    "database"
  ],
  "license": "MIT",
  "dependencies": {
    "@audio/decode-ape": "^1.0.0",
    "@audio/decode-eac3": "^1.0.0",
    "@soundtouchjs/audio-worklet": "^2.1.1",
    "@soundtouchjs/core": "^2.1.1",
    "@tanstack/react-virtual": "^3.14.13",
    "audio-decode": "^3.12.0",
    "essentia.js": "^0.1.3",
    "lucide-react": "^1.55.0",
    "onnxruntime-web": "^1.21.0",
    "parse-audio-metadata": "^1.3.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "rubberband-web": "^0.2.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "wrangler": "^4.149.0"
  }
}
